{
  "name": "files2prompt",
  "displayName": "Files2Prompt Fork",
  "icon": "./files2prompt-icon.webp",
  "description": "Fork of Thomas-McKanna/Files2Prompt. Copy file contents for LLM prompts.",
  "version": "1.8.0",
  "publisher": "gianzapata",
  "keywords": [
    "files",
    "prompt",
    "copy",
    "llm",
    "gpt"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GianZapata/Files2Prompt"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%files2prompt.untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "files2prompt.systemMessage",
        "files2prompt.allowSensitive"
      ]
    }
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:files2PromptView",
    "onView:files2prompt.gitChanges",
    "onView:files2prompt.extensions"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "files2prompt",
          "title": "%files2prompt.container.title%",
          "icon": "resources/files2prompt-icon.svg"
        }
      ]
    },
    "views": {
      "files2prompt": [
        {
          "id": "files2PromptView",
          "name": "%files2prompt.view.name%"
        },
        {
          "id": "files2prompt.gitChanges",
          "name": "%files2prompt.gitChanges.name%",
          "visibility": "collapsed"
        },
        {
          "id": "files2prompt.extensions",
          "name": "%files2prompt.extensions.name%",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "files2prompt.changeOutputFormat",
        "title": "%files2prompt.changeOutputFormat.title%"
      },
      {
        "command": "files2prompt.refresh",
        "title": "%files2prompt.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "files2prompt.copyFiles",
        "title": "%files2prompt.copyFiles.title%",
        "icon": "$(copy)"
      },
      {
        "command": "files2prompt.copyAsXml",
        "title": "%files2prompt.copyAsXml.title%"
      },
      {
        "command": "files2prompt.copyAsMarkdown",
        "title": "%files2prompt.copyAsMarkdown.title%"
      },
      {
        "command": "files2prompt.copyAsPlain",
        "title": "%files2prompt.copyAsPlain.title%"
      },
      {
        "command": "files2prompt.savePromptAs",
        "title": "%files2prompt.savePromptAs.title%",
        "icon": "$(save-as)"
      },
      {
        "command": "files2prompt.copyAsFile",
        "title": "%files2prompt.copyAsFile.title%"
      },
      {
        "command": "files2prompt.clearChecks",
        "title": "%files2prompt.clearChecks.title%",
        "icon": "$(clear-all)"
      },
      {
        "command": "files2prompt.goBack",
        "title": "%files2prompt.goBack.title%",
        "icon": "$(arrow-left)"
      },
      {
        "command": "files2prompt.goForward",
        "title": "%files2prompt.goForward.title%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "files2prompt.copyOpenFiles",
        "title": "%files2prompt.copyOpenFiles.title%",
        "icon": "$(files)"
      },
      {
        "command": "files2prompt.copyExplorerSelection",
        "title": "%files2prompt.copyExplorerSelection.title%"
      },
      {
        "command": "files2prompt.previewPrompt",
        "title": "%files2prompt.previewPrompt.title%",
        "icon": "$(open-preview)"
      },
      {
        "command": "files2prompt.showDetails",
        "title": "%files2prompt.showDetails.title%",
        "icon": "$(list-selection)"
      },
      {
        "command": "files2prompt.selectAll",
        "title": "%files2prompt.selectAll.title%",
        "icon": "$(checklist)"
      },
      {
        "command": "files2prompt.selectByExtension",
        "title": "%files2prompt.selectByExtension.title%",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "files2prompt.selectChanges",
        "title": "%files2prompt.selectChanges.title%",
        "icon": "$(git-compare)"
      },
      {
        "command": "files2prompt.gitChanges.setScope",
        "title": "%files2prompt.gitChanges.setScope.title%",
        "icon": "$(list-selection)"
      },
      {
        "command": "files2prompt.gitChanges.setBase",
        "title": "%files2prompt.gitChanges.setBase.title%",
        "icon": "$(git-branch)"
      },
      {
        "command": "files2prompt.clearGitChanges",
        "title": "%files2prompt.clearGitChanges.title%",
        "icon": "$(close)"
      }
    ],
    "submenus": [
      {
        "id": "files2prompt.select",
        "label": "%files2prompt.select.title%",
        "icon": "$(checklist)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "files2prompt.copyExplorerSelection",
          "group": "navigation"
        },
        {
          "command": "files2prompt.selectByExtension",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "files2prompt.selectByExtension",
          "when": "view == files2PromptView && viewItem == folder",
          "group": "navigation"
        },
        {
          "command": "files2prompt.selectChanges",
          "when": "view == files2PromptView && viewItem == repository",
          "group": "navigation"
        },
        {
          "command": "files2prompt.gitChanges.setScope",
          "when": "view == files2prompt.gitChanges && viewItem == gitRepo",
          "group": "inline"
        },
        {
          "command": "files2prompt.gitChanges.setBase",
          "when": "view == files2prompt.gitChanges && viewItem == gitRepo",
          "group": "inline"
        },
        {
          "command": "files2prompt.clearGitChanges",
          "when": "view == files2prompt.gitChanges",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "files2prompt.copyFiles",
          "when": "view == files2PromptView",
          "group": "navigation@1"
        },
        {
          "command": "files2prompt.previewPrompt",
          "when": "view == files2PromptView",
          "group": "navigation@2"
        },
        {
          "submenu": "files2prompt.select",
          "when": "view == files2PromptView",
          "group": "navigation@3"
        },
        {
          "command": "files2prompt.selectChanges",
          "when": "view == files2PromptView",
          "group": "navigation@4"
        },
        {
          "command": "files2prompt.clearChecks",
          "when": "view == files2PromptView",
          "group": "navigation@5"
        },
        {
          "command": "files2prompt.copyOpenFiles",
          "when": "view == files2PromptView",
          "group": "1_overflow@1"
        },
        {
          "command": "files2prompt.refresh",
          "when": "view == files2PromptView",
          "group": "1_overflow@2"
        },
        {
          "command": "files2prompt.showDetails",
          "when": "view == files2PromptView",
          "group": "1_overflow@3"
        },
        {
          "command": "files2prompt.savePromptAs",
          "when": "view == files2PromptView",
          "group": "1_overflow@4"
        },
        {
          "command": "files2prompt.copyAsFile",
          "when": "view == files2PromptView",
          "group": "1_overflow@5"
        }
      ],
      "files2prompt.select": [
        {
          "command": "files2prompt.selectAll",
          "group": "1_select@1"
        },
        {
          "command": "files2prompt.selectByExtension",
          "group": "1_select@2"
        },
        {
          "command": "files2prompt.clearChecks",
          "group": "1_select@3"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "files2PromptView",
        "when": "workbenchState == empty",
        "contents": "%files2prompt.welcome%"
      }
    ],
    "keybindings": [
      {
        "command": "files2prompt.refresh",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "focusedView == 'files2PromptView'",
        "title": "%files2prompt.refresh.title%"
      },
      {
        "command": "files2prompt.copyFiles",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == 'files2PromptView'",
        "title": "%files2prompt.copyFiles.title%"
      },
      {
        "command": "files2prompt.clearChecks",
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x",
        "when": "focusedView == 'files2PromptView'",
        "title": "%files2prompt.clearChecks.title%"
      },
      {
        "command": "files2prompt.copyOpenFiles",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "focusedView == 'files2PromptView'",
        "title": "%files2prompt.copyOpenFiles.title%"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "%files2prompt.config.title%",
      "properties": {
        "files2prompt.systemMessage": {
          "type": "string",
          "description": "%files2prompt.systemMessage.description%",
          "default": ""
        },
        "files2prompt.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%files2prompt.exclude.description%"
        },
        "files2prompt.allowSensitive": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%files2prompt.allowSensitive.description%"
        },
        "files2prompt.maxFileBytes": {
          "type": "number",
          "default": 1048576,
          "description": "%files2prompt.maxFileBytes.description%"
        },
        "files2prompt.maxFiles": {
          "type": "number",
          "default": 5000,
          "description": "%files2prompt.maxFiles.description%"
        },
        "files2prompt.maxTotalBytes": {
          "type": "number",
          "default": 8388608,
          "description": "%files2prompt.maxTotalBytes.description%"
        },
        "files2prompt.tokenBudget": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%files2prompt.tokenBudget.description%"
        },
        "files2prompt.includeGenerated": {
          "type": "boolean",
          "default": false,
          "description": "%files2prompt.includeGenerated.description%"
        },
        "files2prompt.confirmIgnoredFolders": {
          "type": "boolean",
          "default": true,
          "description": "%files2prompt.confirmIgnoredFolders.description%"
        },
        "files2prompt.outputFormat": {
          "type": "string",
          "enum": ["xml", "markdown", "plain"],
          "default": "xml",
          "description": "%files2prompt.outputFormat.description%"
        },
        "files2prompt.diffMode": {
          "type": "string",
          "enum": ["diffAndFiles", "diffOnly", "filesOnly"],
          "default": "diffAndFiles",
          "description": "%files2prompt.diffMode.description%"
        },
        "files2prompt.extensionPresets": {
          "type": "object",
          "default": {},
          "description": "%files2prompt.extensionPresets.description%"
        },
        "files2prompt.ignoredExtensions": {
          "type": "string",
          "description": "%files2prompt.ignoredExtensions.description%",
          "default": "png,jpg,jpeg,gif,svg"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write src test scripts .vscode-test.mjs eslint.config.mjs",
    "format:check": "prettier --check src test scripts .vscode-test.mjs eslint.config.mjs",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "test:unit": "node -e \"for (const dir of ['out-test/src', 'out-test/test']) require('fs').rmSync(dir, { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node --test out-test/test/*.test.js",
    "pretest:vscode": "node scripts/make-fixture.mjs && npm run compile && node -e \"require('fs').rmSync('out-test/integration', { recursive: true, force: true })\" && npm run compile:integration",
    "test:vscode": "vscode-test",
    "compile:smoke": "node -e \"require('fs').rmSync('out-test/smoke', { recursive: true, force: true })\" && tsc -p tsconfig.smoke.json",
    "test:smoke": "npm run compile:smoke && node scripts/smoke.mjs",
    "test": "npm run test:unit && npm run test:vscode"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.1",
    "@types/vscode": "1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "mocha": "^12.0.3",
    "prettier": "3.9.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ignore": "^7.0.12"
  }
}
