{
  "name": "files2prompt",
  "displayName": "Files2Prompt Fork",
  "icon": "./files2prompt-icon.webp",
  "description": "Fork of Thomas-McKanna/Files2Prompt. Copy file contents for LLM prompts.",
  "version": "1.8.0",
  "publisher": "gianzapata",
  "keywords": [
    "files",
    "prompt",
    "copy",
    "llm",
    "gpt"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GianZapata/Files2Prompt"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView.files2PromptView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "files2prompt",
          "title": "Files2Prompt Fork",
          "icon": "resources/files2prompt-icon.svg"
        }
      ]
    },
    "views": {
      "files2prompt": [
        {
          "id": "files2PromptView",
          "name": "Files"
        }
      ]
    },
    "commands": [
      {
        "command": "files2prompt.refresh",
        "title": "Refresh Files2Prompt View",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "files2prompt.copyFiles",
        "title": "Copy Files",
        "icon": {
          "light": "resources/light/copy.svg",
          "dark": "resources/dark/copy.svg"
        }
      },
      {
        "command": "files2prompt.clearChecks",
        "title": "Clear All Checks",
        "icon": {
          "light": "resources/light/clear.svg",
          "dark": "resources/dark/clear.svg"
        }
      },
      {
        "command": "files2prompt.goBack",
        "title": "Go Back",
        "icon": {
          "light": "resources/light/back.svg",
          "dark": "resources/dark/back.svg"
        }
      },
      {
        "command": "files2prompt.goForward",
        "title": "Go Forward",
        "icon": {
          "light": "resources/light/forward.svg",
          "dark": "resources/dark/forward.svg"
        }
      },
      {
        "command": "files2prompt.pasteXml",
        "title": "Paste XML",
        "icon": {
          "light": "resources/light/play.svg",
          "dark": "resources/dark/play.svg"
        }
      },
      {
        "command": "files2prompt.copyOpenFiles",
        "title": "Copy Open Files"
      },
      {
        "command": "files2prompt.copyExplorerSelection",
        "title": "Copy as Prompt"
      },
      {
        "command": "files2prompt.previewPrompt",
        "title": "Preview Prompt"
      },
      {
        "command": "files2prompt.showDetails",
        "title": "Ver detalles"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "files2prompt.copyExplorerSelection",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "files2prompt.pasteXml",
          "when": "view == files2PromptView",
          "group": "navigation@0"
        },
        {
          "command": "files2prompt.copyFiles",
          "when": "view == files2PromptView",
          "group": "navigation@1"
        },
        {
          "command": "files2prompt.previewPrompt",
          "when": "view == files2PromptView",
          "group": "navigation@6"
        },
        {
          "command": "files2prompt.showDetails",
          "when": "view == files2PromptView",
          "group": "navigation@7"
        },
        {
          "command": "files2prompt.refresh",
          "when": "view == files2PromptView",
          "group": "navigation@2"
        },
        {
          "command": "files2prompt.clearChecks",
          "when": "view == files2PromptView",
          "group": "navigation@3"
        },
        {
          "command": "files2prompt.goBack",
          "when": "view == files2PromptView",
          "group": "navigation@4"
        },
        {
          "command": "files2prompt.goForward",
          "when": "view == files2PromptView",
          "group": "navigation@5"
        }
      ]
    },
    "keybindings": [
      {
        "command": "files2prompt.refresh",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "files2PromptView.active && files2PromptView.visible && focusedView == 'files2PromptView'",
        "title": "Files2Prompt: Refresh"
      },
      {
        "command": "files2prompt.copyFiles",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "files2PromptView.active && files2PromptView.visible && focusedView == 'files2PromptView'",
        "title": "Files2Prompt: Copy Files"
      },
      {
        "command": "files2prompt.clearChecks",
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x",
        "when": "files2PromptView.active && files2PromptView.visible && focusedView == 'files2PromptView'",
        "title": "Files2Prompt: Clear All Checks"
      },
      {
        "command": "files2prompt.pasteXml",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "files2PromptView.active && files2PromptView.visible && focusedView == 'files2PromptView'",
        "title": "Files2Prompt: Paste XML"
      },
      {
        "command": "files2prompt.copyOpenFiles",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "title": "Files2Prompt: Copy Open Files"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Files2Prompt Settings",
      "properties": {
        "files2prompt.systemMessage": {
          "type": "string",
          "description": "Optional system message to include in the output.",
          "default": ""
        },
        "files2prompt.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra gitignore-style patterns excluded from copied context."
        },
        "files2prompt.maxFileBytes": {
          "type": "number",
          "default": 1048576,
          "description": "Skip a file larger than this many bytes."
        },
        "files2prompt.maxTotalBytes": {
          "type": "number",
          "default": 8388608,
          "description": "Stop copying when the serialized prompt would exceed this many UTF-8 bytes."
        },
        "files2prompt.ignoredExtensions": {
          "type": "string",
          "description": "Comma-separated list of file extensions to ignore during recursive selection. Example: 'png,jpg,jpeg,gif,svg'",
          "default": "png,jpg,jpeg,gif,svg"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write src test eslint.config.mjs",
    "format:check": "prettier --check src test eslint.config.mjs",
    "test": "node -e \"require('fs').rmSync('out-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test out-test/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/vscode": "1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "3.9.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "ignore": "^7.0.12"
  }
}
